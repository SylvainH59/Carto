{
    "version": 8,
    "name": "BDTOPO",
    "glyphs": "https://data.geopf.fr/annexes/ressources/vectorTiles/fonts/{fontstack}/{range}.pbf",
    "sprite": "https://data.geopf.fr/annexes/ressources/vectorTiles/styles/BDTOPO/sprite/sprite_bdtopo",
    "metadata": {
      "maputnik:renderer": "ol",
      "geoportail:tooltip": "BDTOPO/bdtopo_tooltip"
    },
    "sources": {
        "bdtopo": {
          "type": "vector",
          "tiles": [
          "https://data.geopf.fr/tms/1.0.0/BDTOPO/{z}/{x}/{y}.pbf"
          ],
          "url":"https://data.geopf.fr/tms/1.0.0/BDTOPO/metadata.json"
        }
    },
    "transition": {
        "duration": 300,
        "delay": 0
    },
    "layers": [
    {
      "id": "departement_limites",
      "type": "line",
      "source": "bdtopo",
      "source-layer": "departement",
      "minzoom": 4,
      "maxzoom": 19,
      "paint": {
        "line-width": 1.75,
        "line-color": "#FA8072"
      }
    },
	 {
      "id": "arrondissement_limites",
      "type": "line",
      "source": "bdtopo",
      "source-layer": "arrondissement",
      "minzoom": 8,
      "maxzoom": 16,
      "paint": {
        "line-width": 0.75,
        "line-color": "#1b38df"
      }
    },
	 {
      "id": "epci_limites",
      "type": "line",
      "source": "bdtopo",
      "source-layer": "epci",
      "minzoom": 9,
      "maxzoom": 16,
      "paint": {
        "line-width": 0.45,
        "line-color": "#900C3F"
      }
	},
	 {
      "id": "communes_limites",
      "type": "line",
      "source": "bdtopo",
      "source-layer": "commune",
      "minzoom": 15,
      "maxzoom": 17,
      "paint": {
        "line-width": 0.45,
        "line-color": "#52be80"
      }
    },
      {
        "id": "plan_d_eau_limites",
        "type": "line",
        "source": "bdtopo",
        "source-layer": "plan_d_eau",
        "minzoom": 14,
        "paint": {
          "line-color": "#1f78b4",
          "line-width": 3
        }
      },
      {
        "id": "plan_d_eau_surf",
        "type": "fill",
        "source": "bdtopo",
        "source-layer": "plan_d_eau",
        "paint": {
          "fill-color": " #aed6f1",
          "fill-opacity": 0.5
        }
      },	
      {
        "id": "cours_d_eau",
        "type": "line",
        "source": "bdtopo",
        "source-layer": "cours_d_eau",
        "paint": {
          "line-color": "#0066cc",
          "line-dasharray": [6, 2],
          "line-width": 1.5
        },
        "minzoom": 13,
        "layout": {
		  "visibility": "visible"
		}
      },
	  {
        "id": "route",
        "type": "line",
        "source": "bdtopo",
        "source-layer": "troncon_de_route",
        "minzoom": 13,
        "paint": {
          "line-color": "#000000",
          "line-width": 3
        }
      },
	  {
        "id": "bati",
        "type": "fill",
        "source": "bdtopo",
        "source-layer": "batiment",
        "minzoom": 14,
        "paint": {
          "fill-color": "#f32b08"
        }
      },{
		"id": "eoliennes",
		"type": "circle",
		"source": "bdtopo",
		"source-layer": "construction_ponctuelle",
        "filter": ["all", ["==","nature", "Eolienne"]],
		"paint": {
		  "circle-color": "#999999",
		  "circle-radius": 10
		},
		"minzoom": 13,        
		"layout": {
		  "visibility": "none"
		}
	  }
    ]
}
